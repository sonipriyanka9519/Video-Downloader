<?xml version="1.0" encoding="utf-8"?>
<!--
  The default-browser sheet's own back. Rounded at the top only, because the bottom of a sheet is
  the bottom of the screen and a corner there would leave a sliver of whatever is behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/surface" />

    <corners
        android:topLeftRadius="@dimen/_18sdp"
        android:topRightRadius="@dimen/_18sdp" />
</shape>
