<?xml version="1.0" encoding="utf-8"?>
<!--
  The sheet's own back: warm at the top, fading to white by the time the benefits card sits on it.

  Rounded at the top only, because the bottom of a sheet is the bottom of the screen and a corner
  there would leave a sliver of the page showing beneath it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:centerColor="@color/default_sheet_mid"
        android:centerY="0.32"
        android:endColor="@color/default_sheet_bottom"
        android:startColor="@color/default_sheet_top"
        android:type="linear" />

    <corners
        android:topLeftRadius="@dimen/_20sdp"
        android:topRightRadius="@dimen/_20sdp" />
</shape>
