<?xml version="1.0" encoding="utf-8"?>
<!--
  The tile behind a feature glyph on the default-browser prompt.

  One drawable for all three rows, not three. The reference gives each row its own hue; this uses
  the app's accent-soft for every one and lets the glyph carry the meaning, because three new
  colours would be a palette the rest of the app has never seen, introduced for a single sheet.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_accent_soft" />
    <corners android:radius="@dimen/ds_radius_card" />
</shape>
