<?xml version="1.0" encoding="utf-8"?>
<!--
  The tap mark over the home grid — a hollow accent ring standing in for a finger.

  Deliberately not a hand or a cursor: the design's rule is that nothing in the artwork should look
  like a control, and a ring reads as "here" without reading as something to press.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/ds_stroke_heavy"
        android:color="@color/ds_accent" />
</shape>
