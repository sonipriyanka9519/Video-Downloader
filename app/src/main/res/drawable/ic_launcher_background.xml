<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's field: the same gradient the splash mark carries.

  Filled edge to edge rather than drawn as a rounded square, because the rounding is not ours to
  decide — the launcher masks an adaptive icon to whatever shape it uses, circle on one phone and
  squircle on the next, and a shape drawn in here would only be cut by that one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="@color/splash_mark_start"
                    android:offset="0.0" />
                <item
                    android:color="@color/splash_mark_mid"
                    android:offset="0.55" />
                <item
                    android:color="@color/splash_mark_end"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
