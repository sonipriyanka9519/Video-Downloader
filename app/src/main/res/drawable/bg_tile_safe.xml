<?xml version="1.0" encoding="utf-8"?>
<!-- The disc behind a benefit's icon. One colour each, so the three read as distinct things
     rather than as three copies of the same badge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <gradient
        android:angle="270"
        android:endColor="#6D4AEF"
        android:startColor="#9B7BFF"
        android:type="linear" />
</shape>
