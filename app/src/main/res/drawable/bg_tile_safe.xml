<?xml version="1.0" encoding="utf-8"?>
<!-- The tile behind a benefit's icon. One per benefit, so the three read as a list of distinct
     things rather than as three copies of the same badge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:endColor="#6366F1"
        android:startColor="#A78BFA"
        android:type="linear" />

    <corners android:radius="@dimen/_10sdp" />
</shape>
