<?xml version="1.0" encoding="utf-8"?>
<!--
  Share, outlined, 24dp.

  Material draws this one with three solid dots in both its filled and outlined variants, which
  is why swapping the glyph did not help — it is filled by construction. Redrawn as stroked
  rings and lines so it carries the same hairline weight as Rename, Folder and Info beside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- The two arms first, so the rings are drawn over where they meet. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8.6,10.7 L15.4,6.6 M8.6,13.3 L15.4,17.4"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M18,2.8a2.7,2.7 0 1,1 0,5.4a2.7,2.7 0 1,1 0,-5.4z M6,9.3a2.7,2.7 0 1,1 0,5.4a2.7,2.7 0 1,1 0,-5.4z M18,15.8a2.7,2.7 0 1,1 0,5.4a2.7,2.7 0 1,1 0,-5.4z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />
</vector>
