<?xml version="1.0" encoding="utf-8"?>
<!-- The tab in front. Same geometry as the resting card, so switching between them cannot move
     anything; only the colour of the edge changes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container" />
    <stroke
        android:width="@dimen/_2sdp"
        android:color="@color/brand_crimson" />
    <corners android:radius="@dimen/_14sdp" />
</shape>
