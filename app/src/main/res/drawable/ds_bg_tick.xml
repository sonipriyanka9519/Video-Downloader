<?xml version="1.0" encoding="utf-8"?>
<!--
  The square tick on a collection row in add mode.

  A drawable rather than a CheckBox: the row is the target, and a real checkbox inside it would
  be a second thing to hit that does the same job in a smaller area.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_accent" />
            <corners android:radius="@dimen/ds_radius_chip_square" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/ds_stroke_selected"
                android:color="@color/ds_ink_faint" />
            <corners android:radius="@dimen/ds_radius_chip_square" />
        </shape>
    </item>
</selector>
