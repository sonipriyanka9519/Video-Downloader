<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark as the opening screen shows it: the icon tile, rounded corners and all.

  One vector rather than a shape with a glyph laid over it. A layer-list scales each layer to the
  bounds it is given, so the glyph's proportions depended on insets chosen to match — get them
  wrong and the arrow stretches. Drawn in one canvas the two parts cannot drift apart.

  The corners are drawn here because nothing masks this one: the launcher icon leaves its rounding
  to the launcher, and this is an ImageView, which rounds nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M24,0h60a24,24 0 0 1 24,24v60a24,24 0 0 1 -24,24h-60a24,24 0 0 1 -24,-24v-60a24,24 0 0 1 24,-24z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="@color/splash_mark_start"
                    android:offset="0.0" />
                <item
                    android:color="@color/splash_mark_mid"
                    android:offset="0.55" />
                <item
                    android:color="@color/splash_mark_end"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,19h18v32h11l-20,22 -20,-22h11z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,81h44v8h-44z" />
</vector>
