<?xml version="1.0" encoding="utf-8"?>
<!--
  The circle that blooms under a double-tap. Faint on purpose: it confirms the tap landed and
  says which way it seeks, and anything stronger would compete with the video for a third of a
  second at a time.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/ds_player_gesture" />
</shape>
