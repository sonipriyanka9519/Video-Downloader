<?xml version="1.0" encoding="utf-8"?>
<!--
  The brand crimson given some depth. A flat fill over a whole screen reads as a colour swatch;
  the diagonal shift towards the darker tone gives the surface a direction.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="290"
        android:centerColor="@color/brand_crimson"
        android:endColor="@color/brand_crimson_dark"
        android:startColor="@color/splash_top"
        android:type="linear" />
</shape>
