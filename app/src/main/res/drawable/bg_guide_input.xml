<?xml version="1.0" encoding="utf-8"?>
<!--
  The paste box.

  Rounded on the left and square on the right, because the search button butts straight up against
  it: the two are one control, and a rounded edge in the middle of a control reads as two.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/guide_input_surface" />

    <corners
        android:bottomLeftRadius="@dimen/_8sdp"
        android:bottomRightRadius="0dp"
        android:topLeftRadius="@dimen/_8sdp"
        android:topRightRadius="0dp" />
</shape>
