<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain disc in the darker of the two neutral fills, for a control sitting on a surface-alt pill.

  It needs the extra step of contrast to be visible at all: the same fill as the pill behind it
  would make the button a glyph floating in the field.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/ds_line" />
</shape>
