<?xml version="1.0" encoding="utf-8"?>
<!-- The standard card: surface with a 1dp line, never a shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ds_surface" />
    <stroke android:width="@dimen/ds_stroke" android:color="@color/ds_line" />
    <corners android:radius="@dimen/ds_radius_card" />
</shape>
