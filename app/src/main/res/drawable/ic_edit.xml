<?xml version="1.0" encoding="utf-8"?>
<!--
  Rename, outlined, 24dp.

  Material's pencil is a solid silhouette in every variant it ships, so this is drawn rather than
  imported: the barrel and the tip as one stroked outline, with a line where the ferrule sits.
  Same 1.8dp weight as Share beside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M4,20L4,16.2L16.1,4.1a1.6,1.6 0 0,1 2.3,0L19.9,5.6a1.6,1.6 0 0,1 0,2.3L7.8,20Z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />

    <!-- Where the metal band crosses the barrel — what makes it read as a pencil, not a wedge. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M14.6,5.6 L18.4,9.4"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>
