<?xml version="1.0" encoding="utf-8"?>
<!--
  home — Material Symbols Rounded, outlined, with a doorway.

  Stroked rather than filled, so the weight matches the outlined chevrons beside it, and drawn
  with round joins and caps because the icon set is Rounded throughout: a sharp-cornered house
  next to rounded chevrons is a different family, not a different icon.

  Outlined by request. The design foundation draws this one filled — see 00 Design Foundation —
  so this is a deliberate departure and should not be "corrected" back.

  The stroke is what carries the shape, so there is no fill: android:tint colours it, which is
  how the toolbar's ds_ink reaches it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Roof and walls, with an opening at the bottom for the doorway. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M4.2,10.9
            L11.35,4.75
            Q12,4.2 12.65,4.75
            L19.8,10.9
            V18.7
            Q19.8,20 18.5,20
            H14.1
            V15.1
            Q14.1,14.2 13.2,14.2
            H10.8
            Q9.9,14.2 9.9,15.1
            V20
            H5.5
            Q4.2,20 4.2,18.7
            Z"
        android:strokeWidth="1.8"
        android:strokeColor="@android:color/white"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>