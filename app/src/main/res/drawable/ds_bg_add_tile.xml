    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/_1sdp"
        android:color="@color/ds_ink_faint"
        android:dashWidth="@dimen/_3sdp"
        android:dashGap="@dimen/_3sdp" />
</shape>
