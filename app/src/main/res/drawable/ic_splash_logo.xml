<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark as the system splash draws it, which is the same mark as the launcher icon and the same
  one the opening screen shows a moment later. All three being one thing is the whole point: the
  icon is tapped, the system splash holds it, and the app's own screen takes it over — three
  handovers that should look like no handover at all.

  Sized to the adaptive-icon convention: a 108dp canvas with the artwork inside the middle ~66dp,
  because the splash masks the icon to a circle and crops anything outside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="@color/splash_mark_start"
                    android:offset="0.0" />
                <item
                    android:color="@color/splash_mark_mid"
                    android:offset="0.55" />
                <item
                    android:color="@color/splash_mark_end"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,30h12v24h8l-14,16 -14,-16h8z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,76h32v6h-32z" />
</vector>
