<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark as the system splash draws it - the same mark as the launcher icon and the same one the
  opening screen shows a moment later. All three being one thing is the whole point: the icon is
  tapped, the system splash holds it, and the app's own screen takes it over, and none of those
  three handovers should be visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/ds_accent"
        android:pathData="M0,0h108v108h-108z" />

    <!--
      ic_download, sized to the same proportion activity_splash uses: a 96dp disc with 20dp of
      padding, so the glyph is 56 of 96. Scaled to 41.6 of the ~72dp the launcher mask actually
      shows, and translated so its centre lands on 54.
    -->
    <group
        android:scaleX="0.065"
        android:scaleY="0.065"
        android:translateX="22.8"
        android:translateY="22.8">
        <path
            android:fillColor="@color/ds_on_accent"
            android:pathData="
M480,640L280,440L336,382L440,486L440,160L520,160L520,486L624,382L680,440L480,640ZM240,800Q207,800 183.5,776.5Q160,753 160,720L160,600L240,600L240,720Q240,720 240,720Q240,720 240,720L720,720Q720,720 720,720Q720,720 720,720L720,600L800,600L800,720Q800,753 776.5,776.5Q753,800 720,800L240,800Z
" />
    </group>
</vector>
