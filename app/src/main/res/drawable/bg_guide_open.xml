<?xml version="1.0" encoding="utf-8"?>
<!--
  The button at the foot of a guide.

  Its own drawable rather than bg_pill_brand, which the tabs sheet also uses — the two are not the
  same button and should not have to change together. Flat brand fill and square corners, matching
  the search button beside the paste box.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/_30sdp"/>
    <solid android:color="@color/brand_crimson" />
</shape>
