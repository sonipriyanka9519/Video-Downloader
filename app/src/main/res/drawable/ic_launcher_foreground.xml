<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark's glyph, on the 108dp canvas an adaptive icon is drawn on.

  Kept inside the middle 66dp — the safe zone. Everything outside that can be cropped by the
  launcher's mask or eaten by the parallax it applies when the icon is dragged, so artwork that
  strays out of it is artwork that may or may not be there depending on the phone.

  Doubles as the monochrome layer, which is why it is a single solid silhouette: a themed icon is
  drawn from this shape's alpha alone, and any colour in it would simply be discarded.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,30h12v24h8l-14,16 -14,-16h8z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,76h32v6h-32z" />
</vector>
