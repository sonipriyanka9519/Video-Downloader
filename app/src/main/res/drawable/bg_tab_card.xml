<?xml version="1.0" encoding="utf-8"?>
<!--
  The stroke is the same width as the highlighted card's, and the card pads by that much, so the
  two states are the same size and the border of neither is painted over by the preview inside it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container" />
    <stroke
        android:width="@dimen/_2sdp"
        android:color="@color/outline_variant" />
    <corners android:radius="@dimen/_14sdp" />
</shape>
