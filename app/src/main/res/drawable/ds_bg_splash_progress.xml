<?xml version="1.0" encoding="utf-8"?>
<!--
  The opening's progress bar: a line-coloured track with an accent fill, both fully rounded.

  A layer-list rather than a themed default, because the platform's own horizontal bar draws a track
  at a fraction of the primary colour — which on this screen is a pink line nobody chose.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_line" />
            <corners android:radius="@dimen/ds_radius_progress" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/ds_accent" />
                <corners android:radius="@dimen/ds_radius_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
