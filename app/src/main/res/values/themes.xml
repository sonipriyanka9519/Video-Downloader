<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      DayNight, following the system.

      It was light-only, on the grounds that dark chrome around somebody else's light page reads
      as broken. The page keeps its own colours either way — forceDarkAllowed is off below — so
      what that argument actually bought was a light app at midnight, which the design set
      rejects: every screen is drawn in both themes.

      Every colour named below has a night twin in values-night/colors.xml, so screens still
      wearing the MVP palette follow along rather than turning into light text on a dark surface.
    -->
    <style name="Base.Theme.Webview" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="android:colorBackground">@color/surface</item>
        <!--
          What the window paints before any layout has drawn on it.
          
          Without this it falls back to colorBackground, which is #FFFBFF - white. Every screen in
          the app is ds_bg, #FAF7F6, so there was a white frame at the front of every activity
          transition. Barely noticeable between two of the app's own screens; very noticeable
          coming back from a full-screen ad, which is where it was finally spotted.
        -->
        <item name="android:windowBackground">@color/ds_bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!--
          Dark icons on a light app, light icons on a dark one. Driven by a bool with a night
          copy rather than a hardcoded true, which is what left the clock and battery invisible
          the first time the app went dark.
        -->
        <item name="android:windowLightStatusBar">@bool/ds_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">
            @bool/ds_light_system_bars
        </item>
        <!-- Pages are rendered as their authors intended, not force-inverted. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Every screen opens the same way — see Animation.Ds.Activity. -->
        <item name="android:windowAnimationStyle">@style/Animation.Ds.Activity</item>
    </style>

    <!--
      How a screen arrives: it grows the last 8% into place and fades in, while the one it
      covers holds still and dims. Set on the theme rather than called at each startActivity,
      so every screen in the app opens the same way and nothing has to remember to ask.

      The system's own animator scale is respected automatically: Android multiplies these
      durations by it, so somebody who has turned animations off gets none of this.
    -->
    <style name="Animation.Ds.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/ds_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/ds_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/ds_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/ds_activity_close_exit</item>
    </style>

    <style name="Theme.Webview" parent="Base.Theme.Webview" />

    <!--
      The search screen.

      It used to open with no animation at all, on the argument that it replaces the address bar
      with a version of itself that can be typed into — the same thing at two moments, so nothing
      should look like travel. That was reversed by request: it now arrives like every other
      screen, growing the last of the way in. Inheriting rather than naming an animation of its
      own is what keeps it that way without a second thing to remember.
    -->
    <style name="Theme.Webview.Search" parent="Theme.Webview" />

    <!--
      Shown by the system from the moment the icon is tapped until the first frame is drawn.
      No timer and no extra activity: an artificial delay would only make the app slower.

      White, matching the screen it hands over to. It used to be crimson, which was right while
      the opening was a field of brand colour and is wrong now — the system splash and the
      activity behind it are meant to look like one screen, and two colours make the handover
      visible as a flash.
    -->
    <style name="Theme.Webview.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Webview.SplashContent</item>
    </style>

    <!--
      The opening itself. Its ground is splash_surface, which holds the same value as ds_bg in
      both themes - so the splash, the window behind every activity, and the app's own pages are
      one continuous colour and no transition between them shows a seam.
    -->
    <style name="Theme.Webview.SplashContent" parent="Theme.Webview">
        <item name="android:windowBackground">@color/splash_surface</item>
        <!--
          Inherited from the base theme now. It used to force light bars, which was right while
          the opening was always white and wrong the moment splash_surface gained a night value:
          dark icons on a dark splash are no icons at all.
        -->
    </style>

    <!--
      One action in a sheet: an icon, a word, and the whole width to be tapped on. Declared once
      because four of them in a row have to line up, and four copies of the same eight attributes
      is four chances for one of them not to.
    -->
    <style name="Widget.Webview.SheetAction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">@dimen/_16sdp</item>
        <item name="android:drawableTint">@color/on_surface_variant</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/_18sdp</item>
        <item name="android:paddingVertical">@dimen/_13sdp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <!--
      A guide's screenshots, rounded off. An ImageView clips nothing, so the corners have to come
      from a shape the view is drawn through rather than from the picture — which is what makes
      this work for screenshots dropped in later without editing them first.
    -->
    <style name="ShapeAppearance.Webview.GuideStep" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_10sdp</item>
    </style>

    <!--
      Material 3 gives a floating action button a rounded-square shape by default; this makes
      it a circle, which reads better as a single-purpose action over a web page.
    -->
    <style name="ShapeAppearance.Webview.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
      The pill behind the selected bottom-nav icon. Tinted from the brand container rather than
      the default surface tint, so the selection reads as the app's own colour.
    -->
    <!--
      No indicator at all. Material 3 draws a filled pill behind the chosen icon; on a two-tab bar
      it is a large shape asserting something the colour of the icon has already said, and it
      crowds a bar this short.
    -->
    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <!-- Small and quiet: the label names the icon, it does not compete with it. -->
    <style name="TextAppearance.Webview.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!--
      The player is the one place a dark surround is right.

      Its parent is a Material theme rather than this app's, because the dark surround is the whole
      point - which also meant it inherited none of Base.Theme.Webview, including the shared screen
      animation. It slid in from the side while every other screen grew into place, and it was the
      only screen in the app that did. Named here rather than left to the parent.
    -->
    <style name="Theme.Webview.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowAnimationStyle">@style/Animation.Ds.Activity</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>
