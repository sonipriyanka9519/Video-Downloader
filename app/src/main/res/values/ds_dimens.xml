    -->
    <dimen name="ds_empty_block">@dimen/_80sdp</dimen>
    <dimen name="ds_empty_block_pad">@dimen/_22sdp</dimen>

    <!-- Empty state never wider than this, so the sentence stays one thought. -->
    <dimen name="ds_empty_max_width">@dimen/_233sdp</dimen>
    <dimen name="ds_empty_icon_block">@dimen/_53sdp</dimen>

    <!-- Screen 17 panel D - the app mark above the About list. -->
    <dimen name="ds_about_mark">@dimen/_53sdp</dimen>

    <!-- Screen 17 panel E - the tile behind the icon that heads a prompt sheet. -->
    <!-- The default-browser prompt: the height of the accent wash, and its feature tiles. -->
    <dimen name="ds_default_wash">@dimen/_120sdp</dimen>
    <dimen name="ds_default_tile">@dimen/_30sdp</dimen>
    <dimen name="ds_icon_block">@dimen/_60sdp</dimen>

    <!-- Screen 18 panel B - the stars over the rate prompt, larger than a row icon. -->
    <dimen name="ds_icon_lg">@dimen/_23sdp</dimen>

    <!-- Side padding inside the downloads badge, which is what makes it a pill. -->
    <dimen name="ds_badge_padding">@dimen/_7sdp</dimen>

    <!-- The Add tile's dashed ring - see bg_add_tile. Dash and gap are equal so it reads evenly. -->
    <dimen name="ds_hairline">@dimen/_1sdp</dimen>
    <dimen name="ds_add_tile_dash">@dimen/_3sdp</dimen>

    <!-- The advertiser's icon on a native ad. -->
    <dimen name="ds_icon_block_sm">@dimen/_33sdp</dimen>

    <!--
      The native ad, laid out as a row. 16:9 on the picture so every ad is the same size whatever
      it contains. The card lands near 112dp: taller than the first row version, because the call
      to action is a full-height button now rather than a chip - still a row rather than the block
      it replaced.
    -->
    <!-- The row's height. Both columns fill it, so the picture and the text end level. -->
    <dimen name="ds_space_0">@dimen/_2sdp</dimen>
    <dimen name="ds_ad_card_height">@dimen/_115sdp</dimen>
    <dimen name="ds_ad_media_width">@dimen/_135sdp</dimen>
    <dimen name="ds_ad_media_height">@dimen/_117sdp</dimen>
    <dimen name="ds_ad_icon">@dimen/_21sdp</dimen>
    <dimen name="ds_ad_cta_height">@dimen/_32sdp</dimen>

</resources>
