    <dimen name="ds_thumb_large_width">@dimen/_60sdp</dimen>
    <dimen name="ds_thumb_large_height">@dimen/_34sdp</dimen>
    <!-- A secondary action inside a card: shorter than a screen's primary button. -->
    <dimen name="ds_button_height_mid">@dimen/_37sdp</dimen>
    <dimen name="ds_storage_notice_width">@dimen/_192sdp</dimen>

    <!-- History — screen 12. -->
    <dimen name="ds_search_pill">@dimen/_33sdp</dimen>
    <!-- The X inside the search pill: a disc, inset from the pill's own edge. -->
    <dimen name="ds_history_search_clear">@dimen/_22sdp</dimen>
    <!-- Leaves an 18dp glyph inside a 48dp target — the design's mark, an accessible touch area. -->
    <dimen name="ds_history_close_pad">@dimen/_13sdp</dimen>
    <dimen name="ds_history_chip">@dimen/_14sdp</dimen>

    <!--
      The empty-state mark as every canvas draws it: 96dp with 24dp corners, holding a 44dp glyph.
      Not to be confused with ds_empty_icon_block below — that is 64dp and is the inline hint block
