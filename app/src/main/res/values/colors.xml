<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand -->
    <color name="brand_crimson">#D8323F</color>
    <color name="brand_crimson_dark">#A81F2B</color>
    <!-- The step numbers on a guide, which read as instructions rather than as brand. -->
    <color name="guide_step">#1A73E8</color>
    <!-- The paste row: a pale field with a dark block on the end of it. -->
    <color name="guide_input_surface">#F1F2F4</color>
    <color name="guide_search">#0B3C5D</color>
    <color name="brand_plum">#3A1B45</color>
    <color name="brand_maroon">#6A2338</color>

    <!-- Light scheme. The app is deliberately light-only, so there is one set of these. -->
    <color name="primary">#D8323F</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#FFDAD9</color>
    <color name="on_primary_container">#410008</color>

    <color name="secondary">#6B3A6E</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#F7D8F4</color>
    <color name="on_secondary_container">#28092C</color>

    <color name="surface">#FFFBFF</color>
    <color name="on_surface">#1F1A1B</color>
    <color name="surface_variant">#F5E0E1</color>
    <color name="on_surface_variant">#534345</color>
    <color name="surface_container">#FBF0F1</color>

    <color name="outline">#857375</color>
    <color name="outline_variant">#E3D0D1</color>

    <!-- The copied-link dialog: the panel the address sits in, and the address itself. -->
    <color name="clip_link_surface">#EEF1FD</color>
    <color name="clip_link_text">#1A56DB</color>

    <!--
      The default-browser offer. The sheet warms from the top down, so the heading sits on colour
      and the benefits card sits on white — the eye lands on the words before the list.
    -->
    <color name="default_sheet_top">#FB8C5A</color>
    <color name="default_sheet_mid">#FCE3D2</color>
    <color name="default_sheet_bottom">#FFFFFF</color>
    <color name="default_card">#FFFFFF</color>
    <color name="default_accent">#F04A2F</color>
    <color name="default_close">#40FFFFFF</color>
    <color name="default_action_start">#F0453F</color>
    <color name="default_action_end">#CE1F26</color>

    <!--
      How to download: a pale pill in the browser, and a dark walkthrough behind it. The
      walkthrough is dark on purpose — the step pictures are screenshots of light screens, and a
      light page around them would leave nothing to tell picture from page.
    -->
    <color name="how_to_surface">#EDF0FA</color>
    <color name="how_scrim">#2C2C2E</color>
    <color name="how_step_accent">#F5A623</color>
    <color name="how_dot_idle">#59FFFFFF</color>
    <color name="how_next_start">#F2762B</color>
    <color name="how_next_end">#E01E63</color>

    <!-- The download button before anything has been found. -->
    <color name="fab_idle">#9E9AA0</color>
    <color name="scrim_dark">#B3000000</color>

    <!--
      Browser chrome. Light to match the rest of the app; the address field is a shade darker
      than the bar behind it so it still reads as a field rather than as part of the page.
    -->
    <color name="toolbar_surface">#FFFBFF</color>
    <color name="toolbar_pill">#F1E9EC</color>
    <color name="toolbar_icon">#5A4F52</color>
    <color name="toolbar_text">#1F1A1B</color>
    <color name="toolbar_hint">#8B8085</color>

    <!-- Segmented filter on the downloads screen. -->
    <color name="segment_track">#ECE7EA</color>
    <color name="segment_active">#FFFFFF</color>
    <color name="segment_inactive_text">#6B6570</color>

    <!-- Bottom navigation: white, a hairline above it, and grey for whatever is not chosen. -->
    <color name="nav_surface">#FFFFFF</color>
    <color name="divider">#ECECEF</color>
    <color name="nav_inactive">#9A9AA0</color>

    <!--
      The splash: white, with the brand kept to the mark and the bar. The ornaments are barely
      there on purpose — they are texture behind the name, not pictures to look at.
    -->
    <color name="splash_surface">#FFFFFF</color>
    <color name="splash_ornament">#FDECEC</color>
    <color name="splash_title">#1B1B1F</color>
    <color name="splash_subtitle">#6E6E76</color>
    <color name="splash_track">#E7E9F3</color>
    <color name="splash_track_fill">#E5262F</color>
    <color name="splash_mark_start">#FF8A3D</color>
    <color name="splash_mark_mid">#F0323F</color>
    <color name="splash_mark_end">#E5177B</color>

</resources>
