    <string name="app_tagline">Browse. Detect. Download.</string>

    <!--
      Onboarding. Three pages, each naming one thing the app does, in the order the user will
      meet them — anything longer would be a manual nobody reads.
    -->
    <string name="onboard_title_1">New generation\nsafe &amp; private\nweb browser</string>
    <string name="onboard_body_1">Browse anywhere you like. Nothing you open is shared, and your session stays on your device.</string>
    <string name="onboard_title_2">Every video\non the page,\nfound for you</string>
    <string name="onboard_body_2">Reels, clips and streams are detected as they play — even when a page holds several at once.</string>
    <string name="onboard_title_3">Download in\nthe quality\nyou choose</string>
    <string name="onboard_body_3">Pick a resolution, then watch it offline whenever you want. Saved straight to your gallery.</string>
