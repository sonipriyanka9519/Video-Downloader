    <!--
      The steps, in text again rather than drawn into the screenshots. The name of whatever has to
      be tapped is bolded, which is what lets the line be scanned instead of read.

      Two methods, four steps: share the post straight into this app, or copy its link and bring it
      back. The order matters — sharing is fewer taps, so it goes first.
    -->
    <string name="guide_how_to">How to Download:</string>

    <string name="guide_fb_step_1">Open \"<b>Facebook</b>\" and click \"<b>Share to</b>\"</string>
    <string name="guide_fb_step_2">Select \"<b>Video Downloader</b>\" from the share list</string>
    <string name="guide_fb_step_3">Open \"<b>Facebook</b>\" and click \"<b>Copy link</b>\"</string>
    <string name="guide_fb_step_4">Paste the link above and click \"<b>Search</b>\"</string>

    <string name="guide_ig_step_1">Open \"<b>Instagram</b>\" and click \"<b>Share to</b>\"</string>
    <string name="guide_ig_step_2">Select \"<b>Video Downloader</b>\" from the share list</string>
    <string name="guide_ig_step_3">Open \"<b>Instagram</b>\" and click \"<b>Copy link</b>\"</string>
    <string name="guide_ig_step_4">Paste the link above and click \"<b>Search</b>\"</string>

