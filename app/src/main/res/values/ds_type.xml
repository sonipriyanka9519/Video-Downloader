<?xml version="1.0" encoding="utf-8"?>
<!--
  The type scale, from designs/screens/00 Design Foundation. Roboto throughout — the platform
  sans — with no second family anywhere in the app.

  Sizes are sp so they honour the user's font setting. Layouts built against these must survive
  the largest scale without clipping; where a design shows one line, use maxLines with ellipsize
  rather than a fixed height.

  Every numeric run — sizes, speeds, counts, timecodes — carries tabular figures. Without it a
  progress row visibly jitters as the digits change width while it counts up.
-->
<resources>

    <style name="TextAppearance.Ds" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ds_ink</item>
    </style>

    <!-- Screen titles: "Downloads", "Settings". -->
    <style name="TextAppearance.Ds.TitleXl">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Sheet and dialog titles, video titles in the player. -->
    <style name="TextAppearance.Ds.Title">
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Card and group headings. -->
    <style name="TextAppearance.Ds.Heading">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- List rows, settings rows. Two lines maximum, ellipsized. -->
    <style name="TextAppearance.Ds.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- Metadata: "1.2 MB • 720p • 0:30". -->
    <style name="TextAppearance.Ds.BodySm">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!--
      Group headers: DOWNLOADS, TODAY, CONTINUE WATCHING. Uppercased in the layout rather than
      by textAllCaps, so a translation that should not be shouted can opt out.
    -->
    <style name="TextAppearance.Ds.Label">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Buttons. -->
    <style name="TextAppearance.Ds.Button">
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Nav labels, duration pills, chips. -->
    <style name="TextAppearance.Ds.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ds_ink_faint</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Chip text sits a step above a caption and carries no tabular figures. -->
    <style name="TextAppearance.Ds.Chip">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>
