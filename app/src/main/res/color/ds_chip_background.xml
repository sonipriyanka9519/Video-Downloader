<?xml version="1.0" encoding="utf-8"?>
<!--
  Filter chip fill. Selection reads as an accent-soft fill as well as the text colour, never as
  one signal alone — see the foundation's selection rule.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ds_accent_soft" android:state_checked="true" />
    <item android:alpha="0.45" android:color="@color/ds_surface_alt" android:state_enabled="false" />
    <item android:color="@color/ds_surface_alt" />
</selector>
