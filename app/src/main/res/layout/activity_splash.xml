<?xml version="1.0" encoding="utf-8"?>
<!--
  The opening: the mark, what the app is called, what it does, and how long is left.

  White rather than a field of brand colour. The three ornaments carry the brand instead, faintly
  enough to read as texture, which leaves the name as the only thing on the screen with any weight
  to it — and the name is the one thing this screen exists to say.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_surface">

    <!--
      Ornaments, each hung off its own corner and allowed to run past the edge. A shape cut by the
      screen reads as part of something larger; the same shape tucked fully inside reads as a
      sticker.
    -->
    <ImageView
        android:layout_width="@dimen/_120sdp"
        android:layout_height="@dimen/_150sdp"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/_minus20sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:contentDescription="@null"
        android:src="@drawable/il_splash_burst" />

    <ImageView
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_130sdp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_minus30sdp"
        android:layout_marginEnd="@dimen/_minus25sdp"
        android:contentDescription="@null"
        android:src="@drawable/il_splash_play" />

    <ImageView
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_90sdp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/_minus30sdp"
        android:layout_marginBottom="@dimen/_60sdp"
        android:contentDescription="@null"
        android:src="@drawable/il_splash_film" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_24sdp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="@dimen/_66sdp"
            android:layout_height="@dimen/_66sdp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_splash_mark" />

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/splash_title"
            android:textColor="@color/splash_title"
            android:textSize="@dimen/_21ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/splash_subtitle"
            android:textColor="@color/splash_subtitle"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>

    <!--
      Horizontal and determinate. A spinner says work is happening and cannot say how much; this
      is driven by the length of the opening itself, so it says the one true thing available —
      how much of this screen is left.
    -->
    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/_140sdp"
        android:layout_height="@dimen/_7sdp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/_30sdp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_splash_progress" />

</FrameLayout>
