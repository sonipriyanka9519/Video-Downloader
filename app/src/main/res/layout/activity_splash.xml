<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_30sdp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="@dimen/_82sdp"
            android:layout_height="@dimen/_82sdp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_badge" />

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:letterSpacing="0.06"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/_23ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:letterSpacing="0.03"
            android:text="@string/app_tagline"
            android:textColor="@color/onboard_body"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>

    <!--
      A determinate-looking spinner would be a lie about work that is not happening. This is
      just a sign of life while the app warms up.
    -->
    <ProgressBar
        android:id="@+id/splashProgress"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/_45sdp"
        android:indeterminateTint="@color/onboard_dot_idle" />

</FrameLayout>
