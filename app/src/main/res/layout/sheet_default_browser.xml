<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen 17, panel E — the default-browser prompt.

  Rebuilt from the MVP's version, which sold three features: Safe Browsing, "6x Download Speed" and
  Quick Access. Two of those describe things the app does not do and the third is a performance
  claim nobody measured — the kind of copy Play's misrepresentation policy acts on, and a poor trade
  for a prompt that only has to explain one thing.

  What it explains is the one real consequence: links open here instead of somewhere else. One
  sentence, one button, and a way out that does not look like a mistake.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_bg_sheet_top"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/ds_space_6"
    android:paddingTop="@dimen/ds_space_3"
    android:paddingBottom="@dimen/ds_space_5"
    android:theme="@style/ThemeOverlay.Ds">

    <!--
      The mark, on the accent-soft tile the app uses wherever an icon has to carry a heading. Not
      the launcher icon: this is a question about browsing, and the globe says which of the app's
      two halves is being asked about.
    -->
    <ImageView
        android:layout_width="@dimen/ds_icon_block"
        android:layout_height="@dimen/ds_icon_block"
        android:layout_marginTop="@dimen/ds_space_5"
        android:background="@drawable/ds_bg_block_accent"
        android:contentDescription="@null"
        android:padding="@dimen/ds_space_4"
        android:src="@drawable/ic_globe"
        app:tint="@color/ds_accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_5"
        android:gravity="center_horizontal"
        android:text="@string/default_browser_title"
        android:textAppearance="@style/TextAppearance.Ds.Title"
        android:textColor="@color/ds_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:gravity="center_horizontal"
        android:text="@string/default_browser_body"
        android:textAppearance="@style/TextAppearance.Ds.Body"
        android:textColor="@color/ds_ink_soft" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetDefault"
        style="@style/Widget.Ds.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_button_height"
        android:layout_marginTop="@dimen/ds_space_5"
        android:text="@string/default_browser_set" />

    <!--
      "Not now", not "Cancel". Declining is a perfectly ordinary answer and the app will ask again
      later; cancel would suggest something is being abandoned.
    -->
    <TextView
        android:id="@+id/btnDefaultClose"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_touch_min"
        android:layout_marginTop="@dimen/ds_space_2"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/default_browser_not_now"
        android:textAppearance="@style/TextAppearance.Ds.Button"
        android:textColor="@color/ds_ink_soft" />
</LinearLayout>
