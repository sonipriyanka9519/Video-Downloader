<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_3sdp"
            android:paddingVertical="@dimen/_4sdp">

            <ImageButton
                android:id="@+id/btnHome"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:contentDescription="@string/home"
                android:src="@drawable/ic_home"
                app:tint="@color/toolbar_icon" />

            <ImageButton
                android:id="@+id/btnBack"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:contentDescription="@string/go_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/toolbar_icon" />

            <ImageButton
                android:id="@+id/btnForward"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:contentDescription="@string/go_forward"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/toolbar_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_url_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_11sdp"
                android:paddingEnd="@dimen/_2sdp">

                <!--
                  Reads only. Typing happens in SearchActivity, which this opens: a bar that both
                  displays where you are and accepts what you are typing has to be one or the
                  other at any moment, and the moment it becomes the second it stops answering
                  the first question.
                -->
                <TextView
                    android:id="@+id/addressBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:hint="@string/search_or_url"
                    android:maxLines="1"
                    android:textColor="@color/toolbar_text"
                    android:textColorHint="@color/toolbar_hint"
                    android:textSize="@dimen/_10ssp" />

                <ImageButton
                    android:id="@+id/btnReload"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:contentDescription="@string/reload"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/toolbar_icon" />
            </LinearLayout>

            <!-- How many tabs are open, and the way into them. -->
            <TextView
                android:id="@+id/btnTabs"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:background="@drawable/bg_tab_count"
                android:clickable="true"
                android:contentDescription="@string/open_tabs"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@color/toolbar_icon"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnBrowserMenu"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="@dimen/_2sdp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/toolbar_icon" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pageProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp"
            android:max="100"
            android:visibility="gone" />

        <!--
          Holds the grid and one WebView per open tab, of which at most one is ever visible.
          The WebViews are added here in code rather than declared: a tab's page stays live in
          its own instance, which is the only way switching tabs can avoid reloading it.
        -->
        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!--
              The home screen: the launcher grid, and the offer of a walkthrough directly beneath
              it. One panel rather than two loose children of the frame, so the button follows the
              last row of shortcuts instead of sitting at the bottom of the window with a gap
              above it.

              The grid wraps its content for the same reason. It holds at most a couple of dozen
              sites — five rows at four columns — so it has never needed the whole screen, and
              taking only what it needs is what leaves the button where the shortcuts end.

              Shown with the grid and never over a page: it belongs to the empty screen where
              somebody is deciding where to go. It also goes for good once the walkthrough has
              been read — see BrowserFragment.refreshHowTo.
            -->
            <LinearLayout
                android:id="@+id/homePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/shortcutGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingTop="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_10sdp" />

                <include
                    layout="@layout/view_how_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_4sdp" />
            </LinearLayout>

            <!--
              Inside the page area rather than over the whole window, so it can be dragged
              anywhere on the page and nowhere else: never up over the address bar, never off the
              bottom. Declared last so it draws above the page — every WebView added in code is
              put behind it. See BrowserFragment.makeFabDraggable.
            -->
            <LinearLayout
                android:id="@+id/fabHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/_12sdp"
                android:gravity="end"
                android:orientation="vertical">

                <!--
                  Raises the site's guide again after it has been dismissed. Inside the holder
                  rather than beside it, so it travels with the download button when that is
                  dragged — two loose buttons that drift apart stop reading as a pair.
                -->
                <ImageView
                    android:id="@+id/btnGuideTip"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_7sdp"
                    android:background="@drawable/bg_guide_tip"
                    android:clickable="true"
                    android:contentDescription="@string/how_to_download"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_6sdp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/fabDownload"
                        android:layout_width="@dimen/_43sdp"
                        android:layout_height="@dimen/_43sdp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_5sdp"
                        android:background="@drawable/fab_bg_idle"
                        android:clickable="true"
                        android:contentDescription="@string/download"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="center"
                        android:src="@drawable/ic_download"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/fabBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_fab_badge"
                        android:gravity="center"
                        android:minWidth="@dimen/_16sdp"
                        android:paddingHorizontal="@dimen/_4sdp"
                        android:textColor="@color/brand_crimson"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
