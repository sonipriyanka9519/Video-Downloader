<?xml version="1.0" encoding="utf-8"?>
<!--
  Step 3: our own sheet, with a quality chosen - screen 15.

  The last picture is of this app rather than the site's, because the last step happens here. It
  carries its words for the same reason the menu in step 1 does: the rungs are what somebody is
  about to choose between, and three blank tiles would not say so.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ds_bg_guide_panel"
    android:padding="@dimen/ds_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ds_bg_guide_sheet"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_art_detected"
            android:textColor="@color/ds_ink"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Ds.GuideRung"
                android:text="@string/guide_art_1080" />

            <!-- The rung being chosen: the one accent shape this picture is allowed. -->
            <TextView
                style="@style/Widget.Ds.GuideRung"
                android:layout_marginStart="@dimen/ds_space_1"
                android:background="@drawable/ds_bg_guide_rung_picked"
                android:text="@string/guide_art_720" />

            <TextView
                style="@style/Widget.Ds.GuideRung"
                android:layout_marginStart="@dimen/ds_space_1"
                android:text="@string/guide_art_audio" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:background="@drawable/ds_bg_guide_action"
            android:gravity="center"
            android:paddingVertical="@dimen/ds_space_1"
            android:text="@string/download"
            android:textColor="@color/ds_on_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
