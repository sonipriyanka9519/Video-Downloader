<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_5sdp"
    android:paddingVertical="@dimen/_12sdp">

    <!--
      Each mark carries its own tile, so there is nothing to sit it on.

      The space around the tile is the padding on this row rather than a margin on the mark: the
      grid divides the width into equal columns whatever is inside them, so the only way to open
      a gap between two shortcuts is to hold each one in from its own edges.
    -->
    <ImageView
        android:id="@+id/shortcutIcon"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/shortcutLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_8ssp" />

</LinearLayout>
