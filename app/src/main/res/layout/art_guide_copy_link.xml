<?xml version="1.0" encoding="utf-8"?>
<!--
  Step 1: the post's overflow menu, with Copy link picked out - screen 15.

  The menu carries its real words, because they are the words somebody has to find in the site's own
  app: a picture of three blank rows would show where to look but not what to look for. Everything
  around them stays abstract - no logos, no screenshot, nothing that could be taken for a control on
  this screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ds_bg_guide_panel"
    android:padding="@dimen/ds_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ds_guide_avatar"
                android:layout_height="@dimen/ds_guide_avatar"
                android:background="@drawable/ds_bg_walk_disc" />

            <View
                android:layout_width="@dimen/ds_guide_name"
                android:layout_height="@dimen/ds_guide_bar"
                android:layout_marginStart="@dimen/ds_space_2"
                android:background="@drawable/ds_bg_guide_bar" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="@dimen/ds_icon_small"
                android:layout_height="@dimen/ds_icon_small"
                android:contentDescription="@null"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/ds_ink_soft" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ds_space_2"
            android:layout_weight="1"
            android:background="@drawable/ds_bg_guide_block" />
    </LinearLayout>

    <!-- The menu, over the post and hanging from the corner it opened from. -->
    <LinearLayout
        android:layout_width="@dimen/ds_guide_menu"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/ds_guide_menu_top"
        android:background="@drawable/ds_bg_guide_sheet"
        android:orientation="vertical"
        android:paddingTop="@dimen/ds_space_1"
        android:paddingBottom="@dimen/ds_space_1">

        <TextView
            style="@style/Widget.Ds.GuideMenuRow"
            android:text="@string/guide_art_share_to" />

        <!-- The row this whole step is about. -->
        <TextView
            style="@style/Widget.Ds.GuideMenuRow"
            android:background="@drawable/ds_bg_guide_pick"
            android:text="@string/guide_art_copy_link"
            android:textColor="@color/ds_accent"
            android:textStyle="bold" />

        <TextView
            style="@style/Widget.Ds.GuideMenuRow"
            android:text="@string/guide_art_report" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/ds_guide_arrow_width"
        android:layout_height="@dimen/ds_guide_arrow_height"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="@dimen/ds_space_3"
        android:contentDescription="@null"
        android:src="@drawable/ic_guide_arrow" />
</FrameLayout>
