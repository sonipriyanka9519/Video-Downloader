<?xml version="1.0" encoding="utf-8"?>
<!--
  The download button sits outside the scrolling area on purpose. Inside it, a video with
  several qualities pushed it past the bottom of the pager and it looked missing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Width and height are set at bind time: a portrait reel gets a tall, narrow,
                 centred frame rather than a wide one that crops its middle out. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/thumbCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_113sdp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="@dimen/_11sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    android:contentDescription="@string/thumbnail"
                    android:scaleType="centerCrop" />

                <!-- Covers the frame until the preview settles, then hides itself. -->
                <com.ms.webview.ui.ShimmerView
                    android:id="@+id/thumbShimmer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:layout_width="@dimen/_39sdp"
                    android:layout_height="@dimen/_39sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play"
                    android:src="@drawable/ic_play_circle" />

                <TextView
                    android:id="@+id/badgePlaying"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/_6sdp"
                    android:background="@drawable/bg_badge_accent"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:text="@string/now_playing"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/badgeDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/_6sdp"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_9ssp" />

            <TextView
                android:id="@+id/qualityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:letterSpacing="0.09"
                android:text="@string/quality"
                android:textAllCaps="true"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <!-- Three across, centred, wrapping onto as many rows as needed. The count is
                 recalculated at bind time so one quality fills the row instead of a third. -->
            <GridLayout
                android:id="@+id/qualities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:columnCount="3"
                android:useDefaultMargins="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:backgroundTint="@color/primary"
        android:letterSpacing="0.01"
        android:text="@string/download"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/_11sdp" />

</LinearLayout>
