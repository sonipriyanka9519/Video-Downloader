<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      Kept as a spacer rather than a rule. The bar below is a rounded card now and its own edge is
      what separates it from the page; a line drawn across the top of it would cut the corners off.
      The view stays because MainActivity hides it with the bar - see applyNavVisibility.
    -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp" />

    <!--
      Flat: no pill behind the chosen icon, no shadow under the bar, and the label always showing.
      What marks the current tab is its colour, which is the whole of the difference and needs no
      shape drawn around it — and a label that appears only when chosen makes the other tab a
      guess.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ds_bg_bottom_nav"
        android:minHeight="@dimen/_50sdp"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/BottomNavIndicator"
        app:itemIconSize="@dimen/_19sdp"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextAppearanceActive="@style/TextAppearance.Webview.BottomNav"
        app:itemTextAppearanceInactive="@style/TextAppearance.Webview.BottomNav"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
