<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_15sdp">

    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:gravity="center_horizontal"
        android:text="@string/add_shortcut_title"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:text="@string/add_shortcut_hint"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_9ssp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickerGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp" />

    <TextView
        android:id="@+id/pickerEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_22sdp"
        android:paddingVertical="@dimen/_26sdp"
        android:text="@string/all_shortcuts_added"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_10ssp"
        android:visibility="gone" />

</LinearLayout>
