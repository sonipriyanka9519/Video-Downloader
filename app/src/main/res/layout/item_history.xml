<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_screen_padding"
    android:paddingEnd="@dimen/ds_space_1"
    android:paddingVertical="@dimen/ds_space_2">

    <ImageView
        android:id="@+id/historyIcon"
        android:layout_width="@dimen/ds_icon"
        android:layout_height="@dimen/ds_icon"
        android:contentDescription="@null"
        android:src="@drawable/ic_globe" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ds.Body"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/historyUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ds.BodySm" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/historyRemove"
        style="?attr/borderlessButtonStyle"
        android:layout_width="@dimen/ds_touch_min"
        android:layout_height="@dimen/ds_touch_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove"
        android:padding="@dimen/ds_space_3"
        android:src="@drawable/ic_close"
        app:tint="@color/ds_ink_soft" />
</LinearLayout>
