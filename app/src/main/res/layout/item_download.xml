<?xml version="1.0" encoding="utf-8"?>
<!--
  One download as a row: what it looks like, what it is called, and how big it is.

  The picture leads at the size a video wants to be read at rather than as a stamp beside the text,
  and it carries the two facts that belong on a picture — how long it runs, and how far along it is.
  Everything a row can do beyond playing sits behind the ⋮, so the row itself has one meaning: this
  video, tapped.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_6sdp"
    android:layout_marginVertical="@dimen/_3sdp"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_7sdp">

        <!--
          The card is the frame, not something inside one.

          Everything drawn over the picture lives in here so the rounded corners clip it. The
          progress bars used to sit in a plain FrameLayout wrapped around the card, and a bar
          flush to the bottom edge ran straight out past the two rounded corners.
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_92sdp"
            android:layout_height="@dimen/_56sdp"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface_variant"
                android:contentDescription="@string/thumbnail"
                android:scaleType="centerCrop" />

            <!-- Only on a finished item, where tapping actually plays something. -->
            <ImageView
                android:id="@+id/playBadge"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play_circle"
                android:visibility="gone" />

            <!--
              How long it runs, over the picture. Hidden rather than blank while a download is
              still going: a duration can only be read out of a finished file.
            -->
            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/_3sdp"
                android:background="@drawable/bg_duration"
                android:paddingHorizontal="@dimen/_4sdp"
                android:paddingVertical="@dimen/_1sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:visibility="gone" />


            <!--
              How far through it you got — the same bar a video site draws under a thumbnail.

              Its own view rather than a second state of the download bar above: they mean
              opposite things (one is arriving, one is spent) and they can never both be true,
              so a shared view would mostly be an exercise in remembering to change the colour
              back. Square-ended and flush to the bottom edge, as the design has it.
            -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/watchedBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:visibility="gone"
                app:indicatorColor="@color/ds_accent"
                app:trackColor="@color/ds_watched_track"
                app:trackCornerRadius="0dp"
                app:trackThickness="@dimen/_3sdp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_9sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!--
                  Never played. A dot rather than a word: it marks one row among many at a
                  glance, and it costs the title none of its width. Gone the moment the file has
                  been opened, which is why it is not a permanent column.
                -->
                <View
                    android:id="@+id/unwatchedDot"
                    android:layout_width="@dimen/ds_dot"
                    android:layout_height="@dimen/ds_dot"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/ds_bg_dot"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_surface_variant"
                    android:fontFeatureSettings="tnum"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </LinearLayout>


        <ImageButton
            android:id="@+id/btnMore"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:padding="@dimen/_2sdp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/on_surface_variant" />

        <!--
          Select mode's tick, in the ⋮'s place — screen 07. Not focusable and not clickable: the
          whole row toggles, and a 22dp target beside a full-width one would be the harder way to
          do the same thing.
        -->
        <FrameLayout
            android:id="@+id/selectTick"
            android:layout_width="@dimen/ds_tick"
            android:layout_height="@dimen/ds_tick"
            android:layout_marginStart="@dimen/_2sdp"
            android:background="@drawable/ds_bg_tick"
            android:visibility="gone">

            <ImageView
                android:id="@+id/selectCheck"
                android:layout_width="@dimen/ds_icon_tiny"
                android:layout_height="@dimen/ds_icon_tiny"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/ds_on_accent" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
