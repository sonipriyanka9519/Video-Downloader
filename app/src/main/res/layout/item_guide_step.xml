<?xml version="1.0" encoding="utf-8"?>
<!--
  One step of a per-site guide - screen 15, panel A.

  A number, the instruction, and a drawing of the screen it happens on. The drawing is added in
  code, because it is the one part that differs from step to step and each is its own layout.

  match_parent on both axes, and it has to be: ViewPager2 refuses a page that does not fill it and
  throws the moment the page is attached.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stepNumber"
            android:layout_width="@dimen/ds_guide_number"
            android:layout_height="@dimen/ds_guide_number"
            android:background="@drawable/ds_bg_walk_disc_accent"
            android:gravity="center"
            android:textColor="@color/ds_on_accent"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            tools:text="1" />

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_2"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Ds.Body"
            android:textSize="@dimen/_12ssp"
            tools:text="Open Instagram and tap Copy link" />
    </LinearLayout>

    <!--
      A fixed box, the same on every page. Sized rather than measured from what is inside it,
      because a drawing a little taller than the last would move the dots and the button under it,
      and a step that shifts the furniture as you swipe reads as four screens rather than one.
    -->
    <FrameLayout
        android:id="@+id/stepArt"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_guide_art_height"
        android:layout_marginTop="@dimen/ds_space_3" />
</LinearLayout>