<?xml version="1.0" encoding="utf-8"?>
<!--
  The offer of a walkthrough, included by both screens that can raise it.

  One file rather than the same twelve lines twice: both screens show the same button and open the
  same walkthrough, so a change to either should be made once. No layout params here — where it
  sits is the host's business, and the two hosts differ.

  It stays. It used to disappear once the walkthrough had been read, on the reasoning that help
  already taken is clutter; that was wrong about who is reading. Somebody comes back to this
  question at the third site that behaves differently, not only at the first — and a button that
  has quietly gone is worse than one that was never there, because it was found once.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btnHowTo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_how_to"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/_9sdp">

    <TextView
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        android:background="@drawable/bg_how_dot"
        android:gravity="center"
        android:text="@string/how_to_mark"
        android:textColor="@color/white"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_7sdp"
        android:text="@string/how_to_download"
        android:textColor="@color/brand_crimson"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold" />
</LinearLayout>
