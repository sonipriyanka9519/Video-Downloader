<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen 18, panel B — the rate prompt.

  A sheet rather than a centred dialog. A dialog is for something that has to be decided before
  anything else can happen; this is an optional favour, and it should arrive from the bottom the
  way every other optional thing in this app does.

  Raised after the first successful download, then after every third, until the viewer answers.
  See RatePrompt for the schedule.

  Three actions, not two. "Send feedback" sits beside "Not now" so that somebody whose answer is
  "no, because it keeps failing" has somewhere to put that other than a one-star review.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_bg_sheet_top"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/ds_space_6"
    android:paddingTop="@dimen/ds_space_6"
    android:paddingBottom="@dimen/ds_space_5"
    android:theme="@style/ThemeOverlay.Ds">

    <!--
      The rating, and the only control on this sheet that decides anything.

      Tapping a star fills it and everything before it, and the button underneath then says where
      that answer goes: four or five to the store, three or fewer to an email. Nobody is sent to
      write a public review of an app they have just told us is not working.

      No rating can actually be submitted from in here - Play collects it on its own page - so this
      chooses a destination rather than recording a score.
    -->
    <LinearLayout
        android:id="@+id/rateStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rateStar1"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/ds_space_2"
            android:src="@drawable/ic_star"
            app:tint="@color/ds_ink_faint" />

        <ImageView
            android:id="@+id/rateStar2"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/ds_space_2"
            android:src="@drawable/ic_star"
            app:tint="@color/ds_ink_faint" />

        <ImageView
            android:id="@+id/rateStar3"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/ds_space_2"
            android:src="@drawable/ic_star"
            app:tint="@color/ds_ink_faint" />

        <ImageView
            android:id="@+id/rateStar4"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/ds_space_2"
            android:src="@drawable/ic_star"
            app:tint="@color/ds_ink_faint" />

        <ImageView
            android:id="@+id/rateStar5"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/ds_space_2"
            android:src="@drawable/ic_star"
            app:tint="@color/ds_ink_faint" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_5"
        android:gravity="center_horizontal"
        android:text="@string/rate_title"
        android:textAppearance="@style/TextAppearance.Ds.Title"
        android:textColor="@color/ds_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:gravity="center_horizontal"
        android:text="@string/rate_body"
        android:textAppearance="@style/TextAppearance.Ds.Body"
        android:textColor="@color/ds_ink_soft" />

    <!--
      Disabled until a star is chosen, and its label follows the choice - see RatePrompt.
      A button reading "Rate on Play Store" that quietly opened an email instead would be the
      worst version of this pattern.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRateNow"
        style="@style/Widget.Ds.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_button_height"
        android:layout_marginTop="@dimen/ds_space_5"
        android:enabled="false"
        android:text="@string/rate_now" />

    <!--
      The two ways of saying no, side by side and equally weighted.

      Stacked, "Send feedback" sat below "Not now" and read as an afterthought — which is exactly
      backwards, because it is the one that rescues an unhappy answer from becoming a one-star
      review. On one row they are visibly two answers to the same question.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRateLater"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_touch_min"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/rate_not_now"
            android:textAppearance="@style/TextAppearance.Ds.Button"
            android:textColor="@color/ds_ink_soft" />

        <TextView
            android:id="@+id/btnRateFeedback"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_touch_min"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/about_feedback"
            android:textAppearance="@style/TextAppearance.Ds.Button"
            android:textColor="@color/ds_ink_soft" />
    </LinearLayout>
</LinearLayout>
