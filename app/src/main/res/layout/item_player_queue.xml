<?xml version="1.0" encoding="utf-8"?>
<!--
  One video in the queue — screen 09, panel C.

  The video playing now keeps its place in the list rather than being lifted out of it: an accent
  rail down its left edge, a tinted row, and "Playing now" where the others carry a running time.
  Seeing where you are among what is coming is the whole reason to open this.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/queueRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/ds_screen_padding"
    android:paddingVertical="@dimen/ds_space_2">

    <View
        android:id="@+id/queueRail"
        android:layout_width="@dimen/ds_player_queue_rail"
        android:layout_height="@dimen/ds_player_queue_thumb_height"
        android:background="@drawable/ds_player_queue_rail"
        android:visibility="invisible" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/ds_player_queue_thumb_width"
        android:layout_height="@dimen/ds_player_queue_thumb_height"
        android:layout_marginStart="@dimen/ds_space_3"
        app:cardBackgroundColor="@color/ds_player_queue_thumb"
        app:cardCornerRadius="@dimen/ds_radius_thumb"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/queueThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ds_player_ink"
            android:textSize="14sp"
            tools:text="Kettlebell swing — form check" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/queueNowIcon"
                android:layout_width="@dimen/ds_icon_tiny"
                android:layout_height="@dimen/ds_icon_tiny"
                android:layout_marginEnd="@dimen/ds_space_1"
                android:contentDescription="@null"
                android:src="@drawable/ic_equalizer"
                android:visibility="gone"
                app:tint="@color/ds_player_accent" />

            <!-- "Playing now" on the current row, a running time on every other. -->
            <TextView
                android:id="@+id/queueMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/ds_player_ink_dim"
                android:textSize="12.5sp"
                tools:text="0:45" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
