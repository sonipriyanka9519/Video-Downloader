<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_4sdp"
    android:paddingVertical="@dimen/_9sdp">

    <ImageView
        android:layout_width="@dimen/_17sdp"
        android:layout_height="@dimen/_17sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_search"
        app:tint="@color/on_surface_variant" />

    <TextView
        android:id="@+id/queryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_11ssp" />

    <!-- Puts the search in the box rather than running it, so it can be finished off. -->
    <ImageButton
        android:id="@+id/queryInsert"
        style="?attr/borderlessButtonStyle"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/use_search"
        android:padding="@dimen/_5sdp"
        android:src="@drawable/ic_arrow_insert"
        app:tint="@color/on_surface_variant" />
</LinearLayout>
