<?xml version="1.0" encoding="utf-8"?>
<!--
  What can be done to one download.

  The file's own name at the top, because these four all act on a single file and the sheet is
  raised from a list of them — without it, "Delete" is a question about which one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_default_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/_16sdp"
    android:paddingBottom="@dimen/_12sdp">

    <TextView
        android:id="@+id/moreName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_18sdp"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@color/outline_variant" />

    <TextView
        android:id="@+id/moreShare"
        style="@style/Widget.Webview.SheetAction"
        android:drawableStart="@drawable/ic_share"
        android:text="@string/share" />

    <TextView
        android:id="@+id/moreRename"
        style="@style/Widget.Webview.SheetAction"
        android:drawableStart="@drawable/ic_edit"
        android:text="@string/rename" />

    <TextView
        android:id="@+id/moreProperty"
        style="@style/Widget.Webview.SheetAction"
        android:drawableStart="@drawable/ic_info"
        android:text="@string/property" />

    <TextView
        android:id="@+id/moreDelete"
        style="@style/Widget.Webview.SheetAction"
        android:drawableStart="@drawable/ic_delete"
        android:text="@string/delete" />
</LinearLayout>
