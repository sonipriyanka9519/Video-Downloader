<?xml version="1.0" encoding="utf-8"?>
<!--
  One tab in the switcher — screen 05.

  A header strip inside the card rather than above it: favicon, title, close. The card is the
  whole tab, so its own title belongs within its border.

  The active tab is marked by a 2dp accent border, set in code — the stroke width is declared on
  both states so the preview inside never shifts by a pixel as the selection moves.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tabCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ds_space_2"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="@dimen/ds_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/ds_line"
    app:strokeWidth="@dimen/ds_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_2"
            android:paddingEnd="@dimen/ds_space_1"
            android:paddingVertical="@dimen/ds_space_1">

            <ImageView
                android:id="@+id/tabIcon"
                android:layout_width="@dimen/ds_icon_tiny"
                android:layout_height="@dimen/ds_icon_tiny"
                android:contentDescription="@null"
                android:src="@drawable/ic_globe" />

            <TextView
                android:id="@+id/tabTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Ds.Caption"
                android:textColor="@color/ds_ink"
                android:textSize="12sp"
                tools:text="Jersey outfit ideas" />

            <!-- 28dp of glyph inside a 40dp target: small enough not to crowd a short title,
                 big enough that closing a tab is not a game of accuracy. -->
            <ImageButton
                android:id="@+id/tabClose"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/ds_icon_button"
                android:layout_height="@dimen/ds_icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_tab"
                android:padding="@dimen/ds_space_3"
                android:src="@drawable/ic_close"
                app:tint="@color/ds_ink_soft" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tabPreview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_tab_preview_height"
            android:background="@color/ds_surface_alt"
            android:contentDescription="@string/tab_preview"
            android:scaleType="centerCrop" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
