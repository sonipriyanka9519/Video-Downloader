<?xml version="1.0" encoding="utf-8"?>
<!--
  One download as a tile.

  Same ids as item_download.xml, and that is deliberate: one holder and one binding serve both, so
  what differs between a row and a tile is where the parts sit and never what they mean.

  The picture leads here, where the row leads with its text. A tile is chosen when somebody is
  looking for a video they would recognise on sight rather than reading down a list of names.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:layout_marginVertical="@dimen/_4sdp"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_6sdp">

        <!-- The card is the frame: anything over the picture is clipped by its corners. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_78sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface_variant"
                android:contentDescription="@string/thumbnail"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/playBadge"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play_circle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/_3sdp"
                android:background="@drawable/bg_duration"
                android:paddingHorizontal="@dimen/_4sdp"
                android:paddingVertical="@dimen/_1sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:visibility="gone" />


            <!-- The watched bar, same meaning and same place as on the row. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/watchedBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:visibility="gone"
                app:indicatorColor="@color/ds_accent"
                app:trackColor="@color/ds_watched_track"
                app:trackCornerRadius="0dp"
                app:trackThickness="@dimen/_3sdp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:orientation="horizontal">

            <View
                android:id="@+id/unwatchedDot"
                android:layout_width="@dimen/ds_dot"
                android:layout_height="@dimen/ds_dot"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/ds_bg_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface_variant"
                android:fontFeatureSettings="tnum"
                android:textSize="@dimen/_8ssp" />


            <ImageButton
                android:id="@+id/btnMore"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="@dimen/_2sdp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/on_surface_variant" />

            <!-- Select mode's tick, in the ⋮'s place. The whole tile toggles. -->
            <FrameLayout
                android:id="@+id/selectTick"
                android:layout_width="@dimen/ds_tick"
                android:layout_height="@dimen/ds_tick"
                android:background="@drawable/ds_bg_tick"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/selectCheck"
                    android:layout_width="@dimen/ds_icon_tiny"
                    android:layout_height="@dimen/ds_icon_tiny"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="@color/ds_on_accent" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
