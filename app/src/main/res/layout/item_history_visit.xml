<?xml version="1.0" encoding="utf-8"?>
<!--
  One visited page — screen 12, panel A.

  Its own row rather than the search screen's: this one carries the time it was visited, a count
  chip when the page was opened more than once, and bold on whatever the search matched. The
  suggestion row under the address bar carries none of those and should not grow them.

  Four columns, and the order is the order somebody reads them in: which site, what page, when, and
  the way to forget it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/ds_touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_screen_padding"
    android:paddingEnd="@dimen/ds_space_1">

    <ImageView
        android:id="@+id/visitIcon"
        android:layout_width="@dimen/ds_icon"
        android:layout_height="@dimen/ds_icon"
        android:contentDescription="@null"
        android:src="@drawable/ic_globe" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_3"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="@dimen/ds_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/visitTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Ds.Body"
                android:textSize="@dimen/_12ssp"
                tools:text="Jersey outfit ideas — 32 pins" />

            <!--
              Only when the page was opened more than once. It sits beside the title rather than in
              the metadata line because it is about the title: this is the same page, four times,
              not four pages.
            -->
            <TextView
                android:id="@+id/visitCount"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ds_history_chip"
                android:layout_marginStart="@dimen/ds_space_2"
                android:background="@drawable/ds_bg_pill"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:paddingHorizontal="@dimen/ds_space_2"
                android:textColor="@color/ds_ink_soft"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="×4"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/visitHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ds.BodySm"
            android:textColor="@color/ds_ink_faint"
            android:textSize="@dimen/_10ssp"
            tools:text="pinterest.com" />
    </LinearLayout>

    <!-- "16:43" today, "11 Aug" once the day has a heading of its own that says nothing about it. -->
    <TextView
        android:id="@+id/visitWhen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_2"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/ds_ink_faint"
        android:textSize="@dimen/_10ssp"
        tools:text="16:43" />

    <ImageButton
        android:id="@+id/visitRemove"
        style="?attr/borderlessButtonStyle"
        android:layout_width="@dimen/ds_touch_min"
        android:layout_height="@dimen/ds_touch_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove"
        android:padding="@dimen/ds_history_close_pad"
        android:src="@drawable/ic_close"
        app:tint="@color/ds_ink_faint" />
</LinearLayout>
