<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 4's diagram: three sizes with the middle one chosen — screen 14, B4.

  Bars rather than the real quality cards, and no numbers on them. "720p" printed here would be a
  claim about what this video offers, on a page shown before any video has been found.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/ds_walk_bars"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_walk_bar"
        android:background="@drawable/ds_bg_walk_bar" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_walk_bar_active"
        android:layout_marginTop="@dimen/ds_space_2"
        android:layout_marginBottom="@dimen/ds_space_2"
        android:background="@drawable/ds_bg_walk_bar_accent"
        android:contentDescription="@null"
        android:padding="@dimen/ds_space_2"
        android:src="@drawable/ic_check"
        app:tint="@color/ds_on_accent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_walk_bar"
        android:background="@drawable/ds_bg_walk_bar" />
</LinearLayout>
