<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Dismiss on the left, the count in the middle, the bulk actions on the right — the
         arrangement every tab switcher uses, so it needs no learning. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_8sdp">

        <ImageButton
            android:id="@+id/btnCloseSwitcher"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:contentDescription="@string/close_tabs_view"
            android:src="@drawable/ic_close"
            app:tint="@color/on_surface" />

        <TextView
            android:id="@+id/tabsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold" />

        <!-- Named as well as drawn: it is the action people come here for. -->
        <LinearLayout
            android:id="@+id/btnNewTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_brand"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_9sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingVertical="@dimen/_6sdp">

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:text="@string/new_tab"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Everything else, including the one action that cannot be undone. -->
        <ImageButton
            android:id="@+id/btnTabsMenu"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/on_surface" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_5sdp"
        android:paddingBottom="@dimen/_12sdp" />
</LinearLayout>
