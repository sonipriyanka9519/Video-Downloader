<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Dismiss on the left, the count in the middle, the bulk actions on the right — the
         arrangement every tab switcher uses, so it needs no learning. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_8sdp">

        <ImageButton
            android:id="@+id/btnCloseSwitcher"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:contentDescription="@string/close_tabs_view"
            android:src="@drawable/ic_close"
            app:tint="@color/on_surface" />

        <TextView
            android:id="@+id/tabsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNewTab"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:contentDescription="@string/new_tab"
            android:src="@drawable/ic_add"
            app:tint="@color/on_surface" />

        <TextView
            android:id="@+id/btnCloseAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_6sdp"
            android:text="@string/close_all_tabs"
            android:textColor="@color/brand_crimson"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_5sdp"
        android:paddingBottom="@dimen/_12sdp" />
</LinearLayout>
