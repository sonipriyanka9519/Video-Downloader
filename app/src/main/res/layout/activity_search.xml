<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- The one editable field in the app. The browser's own bar only ever displays. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_3sdp"
        android:paddingVertical="@dimen/_4sdp">

        <!-- Same metrics as the browser's toolbar, so the field lands exactly where the bar was
             rather than a few pixels above or below it. -->
        <ImageButton
            android:id="@+id/btnSearchBack"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/go_back"
            android:src="@drawable/ic_back"
            app:tint="@color/toolbar_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginHorizontal="@dimen/_2sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_11sdp"
            android:paddingEnd="@dimen/_2sdp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="@string/search_or_url"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/toolbar_text"
                android:textColorHint="@color/toolbar_hint"
                android:textSize="@dimen/_10ssp" />

            <ImageButton
                android:id="@+id/btnSearchClear"
                style="?attr/borderlessButtonStyle"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_all"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/toolbar_icon" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingTop="@dimen/_6sdp">

            <!-- The page the browser is on, and the three things worth doing to its address. -->
            <LinearLayout
                android:id="@+id/pageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_omni_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pageIcon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@string/current_page"
                    android:src="@drawable/ic_globe" />

                <LinearLayout
                    android:id="@+id/pageOpen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_4sdp">

                    <TextView
                        android:id="@+id/pageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/pageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/pageShare"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/share_link_via"
                    android:padding="@dimen/_4sdp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/on_surface_variant" />

                <ImageButton
                    android:id="@+id/pageCopy"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy_link"
                    android:padding="@dimen/_4sdp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/on_surface_variant" />

                <ImageButton
                    android:id="@+id/pageEdit"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit_link"
                    android:padding="@dimen/_4sdp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- What is on the clipboard: one line, until the eye is pressed. -->
            <LinearLayout
                android:id="@+id/clipCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/bg_omni_row"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/clipRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_9sdp">

                    <ImageView
                        android:id="@+id/clipIcon"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/link_you_copied"
                        android:src="@drawable/ic_globe" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/clipLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/link_you_copied"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/clipUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_9ssp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/clipReveal"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/show_link"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/on_surface_variant" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/historyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:text="@string/recent"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/_12sdp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
